# PostgreSQL 접속 문자열 (예: postgresql://postgres:비밀번호@localhost:5432/mpw_plus)
DATABASE_URL=
# Knex 커넥션 풀 크기 (비워두면 기본값 min=2, max=10)
DB_POOL_MIN=
DB_POOL_MAX=
# 백엔드 HTTP 포트 (목 서버 mockup/server.js가 3000을 쓰므로 동시 실행을 위해 3001)
PORT=3001
# 세션 쿠키 서명 비밀값 (필수 — 비어 있으면 모든 API 요청이 500). 생성: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# 관리자 seed(02_admin_user.js)용 — seed:run 할 때마다 이 값으로 관리자 계정을 맞춘다
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
# 일반 사용자 테스트 계정 seed(03_test_user.js)용 — 비워두면 계정을 만들지 않는다 (운영 환경에서는 비울 것)
TEST_USER_EMAIL=
TEST_USER_PASSWORD=
TEST_USER_NAME=

# 업로드 파일 저장 루트 (비우면 server/uploads, 상대경로는 server/ 기준). Deliverables 파일은 <루트>/deliverables/{id}.{xlsx|xls}
UPLOAD_DIR=
